generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id                String           @id @default(cuid())
  institutionName   String
  applicationNumber String           @unique
  programCategory   String?          // e.g. "ENGINEERING_AND_TECHNOLOGY" | "OTHER"
  proposedIntake    Int?             // e.g. 300, 600
  status            String           @default("SUBMITTED")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  documents         Document[]
  scrutinyReports   ScrutinyReport[]
}

model Document {
  id               String      @id @default(cuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName         String
  originalName     String
  filePath         String
  fileHash         String?     // SHA-256 file content hash
  mimeType         String
  fileSize         Int
  documentType     String
  extractionStatus String      @default("PENDING")
  extractedData    Json?
  createdAt        DateTime    @default(now())
}

model ScrutinyReport {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluationDate  DateTime    @default(now())
  overallStatus   String      // "COMPLIANT" | "DEFICIENCIES_DETECTED" | "MANUAL_REVIEW_REQUIRED" | "INSUFFICIENT_INPUT"
  totalRulesRun   Int
  passedCount     Int
  deficiencyCount Int
  reviewCount     Int
  missingCount    Int
  findings        Json        // Detailed array of RuleFinding objects
  createdAt       DateTime    @default(now())
}
