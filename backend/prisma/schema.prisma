generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  passwordHash          String
  salt                  String
  name                  String
  role                  String        // "OFFICER" | "MINISTRY_ADMIN"
  designation           String
  department            String?
  isActive              Boolean       @default(true)
  failedLoginAttempts   Int           @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  assignedApplications   Application[] @relation("AssignedOfficer")
  assignedByApplications Application[] @relation("AssignedBy")
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([role])
  @@index([email])
}

model Application {
  id                String           @id @default(cuid())
  institutionName   String
  applicationNumber String           @unique
  programCategory   String?          // e.g. "ENGINEERING_AND_TECHNOLOGY" | "OTHER"
  proposedIntake    Int?             // e.g. 300, 600
  status            String           @default("SUBMITTED")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  assignedOfficerId String?
  assignedOfficer   User?            @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  assignedById      String?
  assignedBy        User?            @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt        DateTime?

  documents              Document[]
  scrutinyReports        ScrutinyReport[]
  authorityVerifications AuthorityVerification[]
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([assignedOfficerId])
  @@index([status])
}

model Document {
  id                     String                  @id @default(cuid())
  applicationId          String
  application            Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName               String
  originalName           String
  filePath               String
  fileHash               String?                 // SHA-256 file content hash
  mimeType               String
  fileSize               Int
  documentType           String
  extractionStatus       String                  @default("PENDING")
  extractedData          Json?
  createdAt              DateTime                @default(now())
  authorityVerifications AuthorityVerification[]
}

model ScrutinyReport {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluationDate  DateTime    @default(now())
  overallStatus   String      // "COMPLIANT" | "DEFICIENCIES_DETECTED" | "MANUAL_REVIEW_REQUIRED" | "INSUFFICIENT_INPUT"
  totalRulesRun   Int
  passedCount     Int
  deficiencyCount Int
  reviewCount     Int
  missingCount    Int
  findings        Json        // Detailed array of RuleFinding objects
  createdAt       DateTime    @default(now())
}

model AuthorityVerification {
  id                    String      @id @default(cuid())
  applicationId         String
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId            String?
  document              Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  batchId               String      // Unique execution ID grouping a verification run
  authorityCategory     String      // "SOCIETY_REGISTRAR" | "REVENUE_DEPARTMENT" | "FIRE_SERVICES" | "COUNCIL_OF_ARCHITECTURE" | "BANK_BRANCH"
  authorityName         String      // e.g. "State Registrar of Public Trusts (Simulated)", "Council of Architecture Roll"
  verificationMode      String      // "SIMULATED_REGISTRY" | "FORMAT_REGISTRY_CHECK" | "MANUAL_CONFIRMATION_ROUTED"
  sourceName            String      // e.g. "Simulated M.P. Registrar Database", "National Roll of Architects", "Official Bank Branch Inquiry"
  queryReference        String?     // The registration/certificate reference queried
  status                String      // "VERIFIED_SIMULATED" | "FORMAT_VALID_UNVERIFIED" | "MISMATCH_DETECTED" | "EXPIRED_AT_SOURCE" | "RECORD_NOT_FOUND" | "CONFIRMATION_PENDING" | "CONFIRMATION_RECORDED" | "SOURCE_UNAVAILABLE"
  submittedFields       Json        // Snapshot of extracted values tested
  authoritativeFields   Json?       // Record returned by simulated authority (or null)
  discrepancies         Json?       // Array of field-level differences [{field, submitted, authoritative, observation}]
  summary               String      // Concise observation summary
  scrutinyActionPrompt  String      // Guidance prompt for the scrutiny committee
  verifiedAt            DateTime    @default(now())
  createdAt             DateTime    @default(now())

  @@index([applicationId, batchId])
  @@index([applicationId, createdAt])
}

model Notification {
  id              String       @id @default(cuid())
  recipientId     String
  recipient       User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type            String       // "APPLICATION_ASSIGNED" | "APPLICATION_REASSIGNED" | "EXTRACTION_FAILED" | "DEFICIENCY_DETECTED" | "ANOMALY_DETECTED" | "AUTHORITY_MISMATCH" | "AUTHORITY_EXPIRED" | "BANK_CONFIRMATION_PENDING" | "BANK_CONFIRMATION_RECORDED" | "UNASSIGNED_APPLICATION"
  title           String
  message         String
  severity        String       @default("INFO") // "INFO" | "WARNING" | "CRITICAL"
  isRead          Boolean      @default(false)
  readAt          DateTime?
  dedupKey        String?      // Distinct key to prevent uncontrolled duplicate notifications
  metadata        Json?        // Contextual references
  createdAt       DateTime     @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([dedupKey])
  @@index([applicationId])
}

model AuditLog {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  actorId       String?
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName     String
  actorRole     String       // "MINISTRY_ADMIN" | "OFFICER" | "SYSTEM" | "UNAUTHENTICATED"
  action        String       // "AUTH_LOGIN" | "APPLICATION_CREATED" | "APPLICATION_ASSIGNED" | "APPLICATION_REASSIGNED" | "DOCUMENT_UPLOADED" | "EXTRACTION_COMPLETED" | "EXTRACTION_FAILED" | "SCRUTINY_EVALUATED" | "AUTHORITY_VERIFICATION_EXECUTED" | "BANK_CONFIRMATION_RECORDED" | "NOTIFICATION_DISPATCHED"
  resourceType  String       // "APPLICATION" | "DOCUMENT" | "SCRUTINY_REPORT" | "AUTHORITY_VERIFICATION" | "USER" | "NOTIFICATION"
  resourceId    String?
  status        String       @default("SUCCESS") // "SUCCESS" | "FAILURE" | "WARNING"
  details       String
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
